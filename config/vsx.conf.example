# vsx configuration
#
# Copy to ~/.config/vsx/vsx.conf (or point VSX_CONFIG at it). Plain shell
# KEY=value lines. Environment variables with the same names override this
# file. Everything here has a default; only VSX_EMAIL_TO really needs setting.

# ---- notifications -----------------------------------------------------
VSX_EMAIL_TO="you@example.com"
#VSX_EMAIL_FROM="vsx@$(hostname)"
#VSX_EMAIL_ENABLED=true          # failure emails + daily digest
#VSX_DIGEST_ENABLED=true         # one summary email per day, even when quiet
#VSX_ISSUES_ENABLED=true         # open/close GitHub issues for failures
#VSX_ISSUE_LABEL=build-failure

# ---- repositories ------------------------------------------------------
#VSX_UPSTREAM_REPO=VSCodium/vscodium
#VSX_RELEASE_REPO=tonykuttai/vscodium-aix-server
#VSX_GITHUB_TOKEN_FILE=$HOME/.config/github/token   # also tried: $HOME/.config/vscodium-aix/github-token   # or export GITHUB_TOKEN

# ---- what to build -----------------------------------------------------
# `vsx build --missing` / `vsx cron` consider every upstream release newer
# than this floor that is not yet published.
#VSX_BACKFILL_FLOOR=1.126.04524
# A version that fails this many times is parked until the retry window
# passes (or `vsx build --retry`).
#VSX_MAX_ATTEMPTS=3
#VSX_RETRY_AFTER_HOURS=24

# ---- source build ------------------------------------------------------
# The VSCodium fork that carries patches/aix and build/aix. A version is built
# from tag aix/<version> when it exists, else from VSX_FORK_REF, whose
# upstream/stable.json must name that version's VS Code tag.
#VSX_FORK_REPO=https://github.com/tonykuttai/vscodium.git
#VSX_FORK_REF=aix
#VSX_FORK_DIR=$HOME/.cache/vsx/fork
# Sourced by the build child first: user-local Node (.nvmrc version), jq, Rust.
#VSX_BUILD_ENV_FILE=$HOME/local/env.sh
# portlibforaix libutil for node-pty; optional prebuilt aix-ppc64 rg (skips the
# Rust build); IBM Open SDK for Rust bin dir for build/aix/ripgrep.sh.
#VSX_AIX_LIBUTIL=$HOME/local/portlibforaix/lib/libutil.so.2
#VSX_AIX_RIPGREP=
#VSX_RUST_HOME=$HOME/local/RustSDK/1.86/bin
#VSX_MAX_OLD_SPACE_SIZE=8192

# ---- directories -------------------------------------------------------
#VSX_STATE_DIR=$HOME/.local/state/vsx     # lock, logs, events, attempts
#VSX_CACHE_DIR=$HOME/.cache/vsx           # downloads, node runtimes, module builds, work trees
#VSX_RELEASES_DIR=$VSX_HOME/releases      # packaged tarballs

# ---- retention ---------------------------------------------------------
#VSX_KEEP_RELEASES=3   # local release dirs + upstream downloads to keep
#VSX_KEEP_LOGS=40

# ---- smoke test (build/aix/verify_reh.sh timeout) ------------------------
#VSX_SMOKE_TIMEOUT=240  # seconds build/aix/verify_reh.sh waits for "Extension host agent listening"
