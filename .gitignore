# Packaged artifacts (published to GitHub releases, never committed)
releases/
*.tar.gz
*.tar.gz.sha256
*.backup-*

# Logs and local state live under ~/.local/state/vsx and ~/.cache/vsx,
# but guard against accidental copies in the checkout.
*.log
.vsx-*/

# Editors / OS
.DS_Store
*.swp
*.swo
*~

# notes/ holds internal incident/status notes and stays out of the repository
# (also listed in .git/info/exclude on the maintainer machine)
notes/
